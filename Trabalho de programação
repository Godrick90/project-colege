from threading import Thread
from queue import Queue
import time
import random

# Fila compartilhada
fila = Queue(maxsize=5)

# Função do produtor
def produtor(id_produtor):
    for i in range(10):
        item = f"Item-{i} do Produtor-{id_produtor}"

        fila.put(item)

        print(f"[PRODUTOR {id_produtor}] produziu -> {item}")

        time.sleep(random.uniform(0.5, 1.5))

# Função do consumidor
def consumidor(id_consumidor):
    for i in range(10):
        item = fila.get()

        print(f"    [CONSUMIDOR {id_consumidor}] consumiu -> {item}")

        time.sleep(random.uniform(0.5, 2))

        fila.task_done()

# Criando threads
produtor1 = Thread(target=produtor, args=(1,))
produtor2 = Thread(target=produtor, args=(2,))

consumidor1 = Thread(target=consumidor, args=(1,))
consumidor2 = Thread(target=consumidor, args=(2,))

# Iniciando threads
produtor1.start()
produtor2.start()

consumidor1.start()
consumidor2.start()

# Esperando finalizar
produtor1.join()
produtor2.join()

consumidor1.join()
consumidor2.join()

print("\nSistema finalizado!")
